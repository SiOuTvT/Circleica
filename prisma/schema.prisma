generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum GameStatus {
  FINISHED
  ONGOING
  HIATUS
  CANCELLED
}

enum ForumPostCategory {
  discussion
  question
  showcase
  guide
  feedback
}

enum NotificationTypeEnum {
  forum_post_like
  forum_comment_like
  forum_comment_new
  follow
  achievement_unlock
  private_message
}

enum NotificationTargetTypeEnum {
  forum_post
  forum_comment
  user
  achievement
  conversation
}

model User {
  id                String                   @id @default(cuid())
  serialId          Int                      @unique @default(autoincrement())
  uid               String                   @unique @default(cuid())
  username          String                   @unique
  email             String                   @unique
  password          String
  avatar            String                   @default("")
  avatarFrameId     String?
  composedAvatarUrl String?                  @default("")
  marksSpent        Int                      @default(0) // 印记商店累计已消费印记（可用余额 = 总印记 - marksSpent）
  banner            String                   @default("")
  bio               String                   @default("")
  role              UserRole                 @default(USER)
  emailVerified     Boolean                  @default(false)
  emailVerifiedAt   DateTime?
  faveGameId        String?
  createdAt         DateTime                 @default(now())
  avatarFrame       AvatarFrame?             @relation(fields: [avatarFrameId], references: [id], onDelete: SetNull)
  faveGame          Game?                    @relation("faveGame", fields: [faveGameId], references: [id], onDelete: SetNull)
  comments          Comment[]
  favorites         Favorite[]
  forumPosts        ForumPost[]
  forumComments     ForumComment[]
  checkIns          CheckIn[]
  resetTokens       PasswordResetToken[]
  emailTokens       EmailVerificationToken[]
  ratings           GameRating[]
  accounts          Account[]
  sessions          Session[]
  following         Follow[]                 @relation("following")
  followers         Follow[]                 @relation("followers")
  notifications     Notification[]           @relation("notifications")
  sentNotifications Notification[]           @relation("notificationTarget")
  collections       Collection[]
  publishedGames    Game[]                   @relation("publisher")
  gameResources     GameResource[]
  forumPostLikes    ForumPostLike[]
  forumCommentLikes ForumCommentLike[]
  commentLikes      CommentLike[]
  achievements      UserAchievement[]
  resourceReports   ResourceReport[]
  resourceDownloads ResourceDownloadLog[]
  auditLogs         AuditLog[]
  ownedFrames       UserAvatarFrame[]
  conversationsInitiated Conversation[] @relation("ConversationInitiator")
  conversationsJoined     Conversation[] @relation("ConversationParticipant")
  sentMessages            Message[]      @relation("MessageSender")

  @@index([role])
  @@index([avatarFrameId])
  @@index([createdAt])
  @@index([faveGameId])
}

model AvatarFrame {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  imageUrl    String
  isPublic    Boolean  @default(true)
  sort        Int      @default(0)
  price       Int      @default(0) // 印记商店价格：0=免费直接可选；>0=需消耗印记兑换
  createdAt   DateTime @default(now())
  users       User[]
  ownedBy     UserAvatarFrame[]

  @@index([isPublic, sort])
  @@index([price])
}

/// 用户已拥有的头像框（印记商店购买记录，避免重复扣费）
model UserAvatarFrame {
  id            String   @id @default(cuid())
  userId        String
  avatarFrameId String
  purchasedAt   DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarFrame   AvatarFrame @relation(fields: [avatarFrameId], references: [id], onDelete: Cascade)

  @@unique([userId, avatarFrameId])
  @@index([userId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Game {
  id                     String                  @id @default(cuid())
  serialId               Int                     @unique @default(autoincrement())
  title                  String
  originalWork           String                  @default("")
  description            String                  @default("")
  coverImage             String                  @default("")
  screenshots            Json                    @default("[]")
  platforms              Json                    @default("[]")
  officialWebsite        String                  @default("")
  languages              Json                    @default("[]") // 游戏语言代码数组（VNDB languages：en/ja/zh/ko…）
  originalLanguage       String                  @default("") // 原始语言代码（VNDB olang：ja/en/zh…）
  ageRating              String                  @default("") // 年龄分级（手动维护：0/12/15/18；VNDB Kana API 无干净年龄分级字段）
  downloadLinks          Json                    @default("[]")
  status                 GameStatus              @default(FINISHED)
  isNsfw                 Boolean                 @default(false)
  vndbId                 String                  @default("")
  viewCount              Int                     @default(0)
  downloadCount          Int                     @default(0)
  favoriteCount          Int                     @default(0)
  isPublished            Boolean                 @default(false)
  publishedAt            DateTime?
  reviewedBy             String?
  reviewedAt             DateTime?
  rejectReason           String                  @default("")
  releaseDate            DateTime?
  gameDuration           String                  @default("")
  englishName            String                  @default("")
  aliases                String                  @default("")
  publisherId            String?
  /// PostgreSQL 全文搜索向量
  searchVector           String                  @default("") @db.Text
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  publisher              User?                   @relation("publisher", fields: [publisherId], references: [id], onDelete: SetNull)
  tags                   GameTag[]
  comments               Comment[]
  favorites              Favorite[]
  reports                GameReport[]
  ratings                GameRating[]
  creators               GameCreator[]
  /// 制作组关联（多对多：一个游戏可挂多个制作组 / 联合制作）
  studios                GameStudio[]
  /// Galvelica 联动锚点（反向）：本 Game 若已被 Galvelica 收录，对应 Work.gameId 指向此处
  galvelicaWork          Work?                   @relation("gameToGalvelica")
  resources              GameResource[]
  resourceDownloads      ResourceDownloadLog[]
  logs                   GameLog[]
  curatedCollectionGames CuratedCollectionGame[]
  faveGameUsers          User[]                  @relation("faveGame")

  @@index([isPublished, isNsfw, createdAt])
  @@index([isPublished, viewCount])
  @@index([isPublished, favoriteCount])
  @@index([title])
  @@index([vndbId])
  @@index([publisherId])
}

/// 制作组 / 社团基础实体（资源站专用，非百科系统）
/// 由 VNDB 摄入期按 normalizedName 归一派生；aliases 收集历史脏写法供未来人工合并。
model Studio {
  id             String       @id @default(cuid())
  normalizedName String       @unique // 小写 + trim 的路由 key / 去重 key
  slug          String       @unique // Archive 稳定可读路由（CJK 直出），与 normalizedName 职责分离
  displayName    String // 规范展示名（后台可手工改）
  aliases        String       @default("[]") // JSON 数组：摄入期收集的所有原始写法
  vndbId         String? // 预留：未来 VNDB producer 关联（不填）
  producerType   String? // 预留：co/in/ng ↔ 商业/个人/同人团体（不填）
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  games          GameStudio[]

  @@index([normalizedName])
}

/// 游戏 ↔ 制作组 关联（多对多，支持联合制作）
model GameStudio {
  gameId   String
  studioId String
  role     String? // 预留：developer/cooperation/...（Phase 1 不填）
  game     Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  studio   Studio  @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@id([gameId, studioId])
  @@index([studioId])
  @@index([gameId])
}

model TagGroup {
  id          String   @id @default(cuid())
  name        String   @unique
  description String   @default("")
  color       String   @default("#7c8a9e")
  positions   Json     @default("[]") // JSON array of position keys
  isPreset    Boolean  @default(false) // 系统内置组，不可删除
  tags        Tag[]
  createdAt   DateTime @default(now())
}

model Tag {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String   @unique // Archive 稳定可读路由（CJK 直出），与 normalizedName 职责分离
  description String    @default("")
  color       String    @default("#a78bfa")
  sortOrder   Int       @default(0)
  isVisible   Boolean   @default(true)
  groupId     String?
  source      String    @default("circleica") // 数据来源：circleica=主站 / galvelica=副站；主站读取恒过滤此值，确保副站摄入数据不窜入主站
  createdAt   DateTime  @default(now())
  group       TagGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  games       GameTag[]
  works       WorkTag[]

  @@index([groupId])
  @@index([sortOrder])
  @@index([source])
}

model GameTag {
  gameId String
  tagId  String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([gameId, tagId])
  @@index([tagId])
}

model Comment {
  id        String        @id @default(cuid())
  gameId    String
  userId    String
  content   String
  imageUrl  String        @default("")
  likeCount Int           @default(0)
  parentId  String?
  createdAt DateTime      @default(now())
  game      Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies   Comment[]     @relation("CommentReplies")
  likes     CommentLike[]

  @@index([gameId, createdAt])
  @@index([userId])
  @@index([parentId])
}

model GameResource {
  id              String              @id @default(cuid())
  gameId          String
  userId          String
  resourceName    String              @default("")
  resourceNote    String              @default("")
  /// JSON 数组：平台标签 ["PC", "Android", ...]
  platform        Json                @default("[]")
  /// JSON 数组：语言标签 ["中文", "日文", ...]
  language        Json                @default("[]")
  /// JSON 数组：运行方式 ["ONS", "Kirikiri", ...]
  runType         Json                @default("[]")
  /// JSON 数组：资源内容 ["本体", "存档", ...]
  resourceContent Json                @default("[]")
  isReported      Boolean             @default(false)
  reportedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  game            Game                @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries         GameResourceEntry[]
  reports         ResourceReport[]
  downloadLogs    ResourceDownloadLog[]

  @@index([gameId])
  @@index([userId])
  @@index([createdAt])
}

model GameResourceEntry {
  id             String       @id @default(cuid())
  resourceId     String
  url            String
  extractCode    String       @default("")
  decompressCode String       @default("")
  fileSize       String       @default("")
  /// 该分流被点击下载的次数（原子 increment，带简单防刷）
  downloadCount  Int          @default(0)
  resource       GameResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId])
}

model ResourceReport {
  id         String       @id @default(cuid())
  resourceId String
  userId     String
  createdAt  DateTime     @default(now())
  resource   GameResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([resourceId, userId])
  @@index([resourceId])
  @@index([userId])
}

/// 用户下载记录（登录用户点击资源下载时写入，用于"我的下载"历史）
model ResourceDownloadLog {
  id          String          @id @default(cuid())
  userId      String
  resourceId  String
  gameId      String
  downloadedAt DateTime       @default(now())
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource    GameResource    @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  game        Game            @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([userId, downloadedAt])
  @@index([gameId])
}

model Favorite {
  id           String      @id @default(cuid())
  userId       String
  gameId       String
  collectionId String?
  createdAt    DateTime    @default(now())
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  game         Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  @@unique([userId, gameId])
  @@index([gameId])
  @@index([collectionId])
}

model Collection {
  id          String     @id @default(cuid())
  userId      String
  name        String
  description String     @default("")
  isDefault   Boolean    @default(false)
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  favorites   Favorite[]

  @@unique([userId, name])
  @@index([userId])
}

model GameReport {
  id        String   @id @default(cuid())
  gameId    String
  ip        String
  reason    String   @default("")
  createdAt DateTime @default(now())
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, ip])
  @@index([createdAt])
}

model Announcement {
  id           String    @id @default(cuid())
  title        String
  summary      String    @default("")
  content      String
  imageUrl     String    @default("")
  link         String    @default("")
  authorName   String    @default("")
  authorAvatar String    @default("")
  status       String    @default("published")
  isPinned     Boolean   @default(false)
  isActive     Boolean   @default(true)
  startAt      DateTime?
  endAt        DateTime?
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([sortOrder])
  @@index([status])
}

model Playlist {
  id        String   @id @default(cuid())
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  music     Music[]

  @@index([sortOrder])
}

model Music {
  id         String    @id @default(cuid())
  title      String
  filename   String
  url        String    @default("")
  isActive   Boolean   @default(true)
  playlistId String?
  createdAt  DateTime  @default(now())
  playlist   Playlist? @relation(fields: [playlistId], references: [id], onDelete: SetNull)

  @@index([playlistId])
  @@index([createdAt])
}

model GameLog {
  id        String   @id @default(cuid())
  gameId    String
  content   String
  createdAt DateTime @default(now())
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  target    String   @default("")
  detail    String   @default("")
  ip        String   @default("")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model Creator {
  id           String        @id @default(cuid())
  vndbId       String        @default("")
  slug         String        @unique // Archive 稳定可读路由（CJK 直出）
  name         String
  nameJa       String        @default("")
  avatar       String        @default("")
  bio          String        @default("")
  gender       String        @default("")
  twitterUrl   String        @default("")
  wikipediaUrl String        @default("")
  createdAt    DateTime      @default(now())
  source       String        @default("circleica") // 数据来源：circleica=主站 / galvelica=副站；主站读取恒过滤此值，确保副站摄入数据不窜入主站
  games        GameCreator[]
  works        WorkCreator[]

  @@index([vndbId])
  @@index([name])
  @@index([createdAt])
  @@index([source])
  @@unique([name, source]) // 防副站摄入并发重复 Creator（与应用层 upsert 双保险）
}

model GameCreator {
  id        String  @id @default(cuid())
  gameId    String
  creatorId String
  role      String // scenario / art / chardesign / music / director / songs
  game      Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([gameId, creatorId, role])
  @@index([gameId])
  @@index([creatorId])
}

model GameRating {
  id        String   @id @default(cuid())
  gameId    String
  userId    String
  score     Int      @db.SmallInt // 1-5
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gameId, userId])
  @@index([gameId])
  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  email     String
  tokenHash String    @unique
  type      String    @default("verify")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CuratedCollection {
  id          String                  @id @default(cuid())
  name        String
  slug        String                 @unique // Archive 稳定可读路由（CJK 直出）
  description String                  @default("")
  sortOrder   Int                     @default(0)
  published   Boolean                 @default(true)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  games       CuratedCollectionGame[]

  @@index([sortOrder])
}

model CuratedCollectionGame {
  id           String            @id @default(cuid())
  collectionId String
  gameId       String
  sortOrder    Int               @default(0)
  collection   CuratedCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  game         Game              @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([collectionId, gameId])
  @@index([collectionId])
  @@index([gameId])
}

model CheckIn {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date
  marks     Int      @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([createdAt])
}

model ForumPost {
  id        String            @id @default(cuid())
  userId    String
  title     String
  content   String
  imageUrl  String            @default("")
  likeCount Int               @default(0)
  isSolved  Boolean           @default(false)
  isPinned  Boolean           @default(false)
  isLocked  Boolean           @default(false)
  category  ForumPostCategory @default(discussion)
  viewCount Int               @default(0)
  updatedAt DateTime          @default(now()) @updatedAt
  createdAt DateTime          @default(now())
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments  ForumComment[]
  likes     ForumPostLike[]

  @@index([userId])
  @@index([createdAt])
  @@index([category])
  @@index([isPinned, category, createdAt])
  @@index([isSolved, createdAt])
}

model ForumComment {
  id        String             @id @default(cuid())
  postId    String
  userId    String
  content   String
  imageUrl  String             @default("")
  likeCount Int                @default(0)
  updatedAt DateTime           @updatedAt
  createdAt DateTime           @default(now())
  post      ForumPost          @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes     ForumCommentLike[]

  @@index([postId, createdAt])
  @@index([userId])
}

model Notification {
  id         String                     @id @default(cuid())
  userId     String // 接收通知的用户
  actorId    String // 触发通知的用户
  type       NotificationTypeEnum
  targetType NotificationTargetTypeEnum
  targetId   String // 关联对象 ID
  isRead     Boolean                    @default(false)
  createdAt  DateTime                   @default(now())
  user       User                       @relation("notifications", fields: [userId], references: [id], onDelete: Cascade)
  actor      User                       @relation("notificationTarget", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([actorId])
  @@index([targetId])
}

model ForumPostLike {
  id        String    @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
}

model ForumCommentLike {
  id        String       @id @default(cuid())
  userId    String
  commentId String
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment   ForumComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@index([commentId])
}

model CommentLike {
  id        String   @id @default(cuid())
  userId    String
  commentId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@index([commentId])
}

/// 私聊会话 — 发起会话需消耗印记（反滥用，防止陌生人轰炸；回复免费）
model Conversation {
  id             String    @id @default(cuid())
  /// 发起者（扣印记方）
  initiatorId    String
  /// 接收者
  participantId  String
  /// 发起者本次会话消耗的印记
  initiatorMarkSpent Int   @default(0)
  lastMessageAt  DateTime  @default(now())
  createdAt      DateTime  @default(now())
  initiator      User      @relation("ConversationInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  participant    User      @relation("ConversationParticipant", fields: [participantId], references: [id], onDelete: Cascade)
  messages       Message[]

  @@unique([initiatorId, participantId]) // 两人之间唯一会话（再次发起不重复扣费）
  @@index([participantId])
  @@index([initiatorId])
  @@index([lastMessageAt])
}

/// 私聊消息
model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}

/// 情感化消息管理 — 可在后台自定义各场景的提示文案和插图
model EmotionalMessage {
  id        String   @id @default(cuid())
  /// 唯一标识，如 "favorite_added", "checkin_success", "empty_search" 等
  key       String   @unique
  /// 场景分类: toast / empty / error / success
  category  String
  /// 正标题
  title     String   @default("")
  /// 副标题或描述
  subtitle  String   @default("")
  /// 插图 URL（可选，用于空状态/错误页等）
  imageUrl  String   @default("")
  /// 自定义 emoji 作为图标替代（当无插图时使用）
  emoji     String   @default("")
  /// 是否启用（禁用时走前端默认文案）
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

/// 全局站点配置 — 键值对存储，用于后台可配置项
model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @default("")
  updatedAt DateTime @updatedAt
}

/// 成就定义 — 由管理员在后台创建
model Achievement {
  id              String            @id @default(cuid())
  name            String // 成就名称
  description     String            @default("") // 成就描述
  icon            String            @default("") // 成就图标 URL
  characterImage  String            @default("") // 解锁卡片角色立绘 URL（透明底 PNG）
  category        String            @default("general") // 分类
  conditionType   String // 条件类型：favorite_count / comment_count / play_count / checkin_streak / forum_post_count / register_days
  conditionTarget Int               @default(1) // 目标值
  points          Int               @default(10) // 积分权重
  hidden          Boolean           @default(true) // 是否隐藏（全部默认隐藏）
  isActive        Boolean           @default(true) // 是否启用
  unlockCount     Int               @default(0) // 解锁人数（定时统计更新）
  createdAt       DateTime          @default(now())
  users           UserAchievement[]

  @@index([category])
  @@index([conditionType])
  @@index([isActive])
  @@index([createdAt])
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
}

// ============================================================
//  Galvelica 资料馆数据层 — 阶段 A 地基表
//  基线：docs/galvelica-data-architecture.md（2026-07-25 ADR）
//  Work 独立于 Game；两站联动唯一锚点 = Work.gameId（唯一可空）。
//  Game/Tag/Creator 反向字段已在上方补回，关系完整。
// ============================================================

enum WorkSourceType {
  VNDB
  BANGUMI
  CNGL
  YMGAL
  EROGESCAPE
  DLSITE
  GETCHU
  FUWANOVEL
  BOOTH
  STEAM
  MANUAL
}

// 同人分类（Galvelica 对外展示）：纯正同人 vs 同人系公司商业作
enum WorkCategory {
  PURE // 纯正同人：个人(in) / 无注册社团(ng)
  DERIVATIVE // 同人系公司：早年同人社团、后期注册公司的厂商作品
}

enum InclusionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// ── Galvelica 档案主体（独立于 Game，可无对应资源） ──
model Work {
  id     String  @id @default(cuid())
  slug   String  @unique // URL 用，如 /galvelica/works/<slug>
  gameId String? @unique // 已被 Circleica 收录则链接 Game；否则 null（联动锚点）
  game   Game?   @relation("gameToGalvelica", fields: [gameId], references: [id], onDelete: SetNull)

  // 融合后的「有效展示值」（单一真相，页面只读这里）
  title        String
  originalWork String    @default("")
  englishName  String    @default("")
  aliases      String    @default("") // 多源合并后的别名，逗号分隔
  description  String    @default("")
  coverImage   String    @default("")
  releaseDate  DateTime?
  studioName   String    @default("")
  status       String    @default("") // 完结/连载等（自由文本，后续可枚举）
  duration     String    @default("") // 对应 Game.gameDuration

  // 媒体/平台/语言（方案B：由 VNDB 等源融合入库，前端渲染；与 Game 同名列一致）
  screenshots      Json   @default("[]") // 截图 URL 数组
  platforms        Json   @default("[]") // 平台代码数组（win/lin/mac/ios/and/…）
  languages        Json   @default("[]") // 语言代码数组（en/ja/zh/ko/…）
  originalLanguage String @default("") // 原始语言代码（ja/en/zh/…）
  officialWebsite  String @default("") // 官方网站

  // ── 阶段0：评分/封面分级/截图分级（NSFW 合规 + 质量分数据源） ──
  rating            Float?            // VNDB 综合评分 0-10（融合来源）；与 ratingAvg 区分：这是源评分原值
  coverSexual       Int      @default(-1) // 封面露骨度：0=安全 1=暗示 2=露骨 -1=未定（VNDB image.sexual / 图像审核 / 人工）
  coverViolence     Int      @default(-1) // 封面暴力分级（VNDB image.violence）
  coverDims         Json?              // 封面尺寸 {width,height}（VNDB image.dims）
  coverSexualSource String   @default("") // 封面分级来源：vndb | auto | manual
  screenshotsSexual Json     @default("[]") // 截图露骨度分级数组，与 screenshots 一一对应（-1=未定）

  isNsfw       Boolean   @default(false)

  // 同人分类（对外展示）：PURE=纯正同人，DERIVATIVE=同人系公司商业作；null=未定（人工/旧数据）
  doujinCategory WorkCategory?

  // 商业系列作品标记（VNDB producers type=co）：副站「同人资料馆」不收录，列表/详情一律排除
  isCommercial Boolean @default(false)

  // 外链（按源选优后归一）
  officialUrl String @default("") // DLsite 优先
  steamAppId  String @default("") // Steam 优先

  // 字段级 provenance：field -> { source, manual }
  provenance   Json     @default("{}")
  // 被人工锁定、融合时跳过的字段名
  manualFields String[] @default([])

  // 评分（融合时优先取本站 Game 评分，见 ADR §5 / §10.2）
  ratingAvg     Float?
  ratingCount   Int    @default(0)
  viewCount     Int    @default(0)
  favoriteCount Int    @default(0)

  // ── 阶段2：质量分（排序）与内容旗标（真人3D等） ──
  qualityScore  Int      @default(0)
  qualitySignal Json     @default("{}") // 质量分子分（cover/screenshot/desc/meta/rating/heat/penalty），后台诊断用
  contentFlags  String[] @default([]) // 内容旗标：LIVE_ACTION / REALISTIC_3D（真人实拍/写实3D，供过滤与质量分扣分）

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastFusedAt DateTime?

  sources  WorkSource[]
  tags     WorkTag[]
  creators WorkCreator[]
  requests InclusionRequest[]

  @@index([title])
  @@index([releaseDate])
  @@index([isNsfw])
  @@index([qualityScore])
  @@index([coverSexual])
}

// ── 每源原始载荷 + 关联（provenance 的底层） ──
model WorkSource {
  id         String         @id @default(cuid())
  workId     String
  work       Work           @relation(fields: [workId], references: [id], onDelete: Cascade)
  source     WorkSourceType
  externalId String // 该源的作品 ID（v12345 / bgm123 / appid ...）
  raw        Json // 该源返回的原始 payload（缓存，供重融合）
  status     String         @default("ok") // ok | stale | error
  fetchedAt  DateTime       @default(now())

  @@unique([workId, source])
  @@unique([source, externalId])
}

// ── 收录申请（Circleica↔Galvelica 联动载体） ──
model InclusionRequest {
  id          String                 @id @default(cuid())
  workId      String
  work        Work                   @relation(fields: [workId], references: [id], onDelete: Cascade)
  requestedBy String? // 发起用户 ID（游客可为空）
  status      InclusionRequestStatus @default(PENDING)
  note        String                 @default("")
  reviewedBy  String?
  decidedAt   DateTime?
  createdAt   DateTime               @default(now())

  @@index([status])
  @@index([workId])
}

// ── 与 GameTag / GameCreator 平行的关系表 ──
model WorkTag {
  workId String
  tagId  String
  work   Work   @relation(fields: [workId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([workId, tagId])
  @@index([tagId])
}

model WorkCreator {
  id        String  @id @default(cuid())
  workId    String
  creatorId String
  role      String // scenario / art / chardesign / music / director / songs
  work      Work    @relation(fields: [workId], references: [id], onDelete: Cascade)
  creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([workId, creatorId, role])
  @@index([creatorId])
}

/// 按用户的浏览历史（继续浏览）：主站 Game 与副站 Work 共用，
/// 同一用户同一目标只保留一条，重复浏览更新 createdAt（最近浏览排前）。
model ViewHistory {
  id         String   @id @default(cuid())
  userId     String
  targetType String // GAME | WORK
  targetId   String
  createdAt  DateTime @default(now())

  @@unique([userId, targetType, targetId])
  @@index([userId, targetType, createdAt])
}
