{
  "name": "circleica",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --max-old-space-size=4096 node_modules/next/dist/bin/next dev --turbopack -p 3000 -H 0.0.0.0",
    "dev:webpack": "node --max-old-space-size=4096 node_modules/next/dist/bin/next dev --webpack -p 3000 -H 0.0.0.0",
    "dev:clean": "node scripts/dev-clean.js && npm run dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "node --require ./scripts/eslint-ts6-shim.cjs ./node_modules/eslint/bin/eslint.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "db:backfill-slugs": "tsx scripts/backfill-archive-slugs.ts",
    "theme:export": "tsx scripts/export-theme.ts",
    "theme:export:sql": "psql -d circleica -f scripts/export-theme.sql",
    "galvelica:backfill": "tsx scripts/backfill-galvelica.ts",
    "galvelica:backfill-media": "tsx scripts/backfill-work-media.ts",
    "galvelica:ingest-vndb": "tsx scripts/ingest-vndb.ts",
    "galvelica:ingest-discovery": "tsx scripts/ingest-discovery.ts",
    "galvelica:ingest-egs": "tsx scripts/ingest-egs.ts",
