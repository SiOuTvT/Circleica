# ═══════════════════════════════════════════
# Circleica 部署配置
# 复制此文件为 .env，无需修改即可启动
# docker compose up -d
# ═══════════════════════════════════════════

# ── 数据库连接 ──
# 默认使用 compose 内置 PostgreSQL，无需配置
# 如使用外部数据库，取消注释并填写：
# DATABASE_URL=postgresql://用户名:密码@主机:端口/数据库名
# DATABASE_URL=

# ── 应用密钥 ──
# 留空则首次启动自动生成（容器重建后用户需重新登录）
# 正式部署建议填写：openssl rand -base64 48
# NEXTAUTH_SECRET=

# ── 网站访问地址 ──
# 必须与用户实际访问地址完全一致（含协议）
# 留空默认 http://localhost:3000
# 正式部署请设置为实际域名，例如：https://fangame.example.com
# NEXTAUTH_URL=

# ── 端口配置 ──
# 对外暴露的 HTTP 端口，默认 3000
# APP_PORT=80

# ═══════════════════════════════════════════
# 以下均为可选配置，不影响核心功能
# ═══════════════════════════════════════════

# ── Cloudflare R2 文件存储（可选，不填则使用本地存储）──
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=

# ── Upstash Redis 缓存（可选，不填则使用内存缓存）──
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Resend 邮件服务（可选，用于密码重置）──
# RESEND_API_KEY=

# ── Brevo 邮件服务（可选，与 Resend 二选一或按顺序回退）──
# 在后台「邮件服务」中配置 Brevo 时，此变量为生产发送密钥
# BREVO_API_KEY=

# ── 邮件服务商顺序（可选）──
# 逗号分隔，例如 resend,brevo 或 brevo,resend；留空默认 resend
# EMAIL_PROVIDER_ORDER=resend,brevo

# ── Sentry 错误监控（可选）──
# 服务端 / Edge 上报用（运行时读取）
# SENTRY_DSN=
# 浏览器端上报用。必须以 NEXT_PUBLIC_ 开头，且必须在【构建期】就存在，
# Next.js 会把它内联进浏览器 bundle；只在运行时给，客户端拿到的是 undefined。
# 两者通常填同一个 DSN。
# NEXT_PUBLIC_SENTRY_DSN=

# ── OpenTelemetry 可观测性（可选，推荐配合 docker-compose.observability.yml 使用）──
# 配置后应用把 Trace / Metrics / Logs 经 OTLP 推送到 OTel Collector → Grafana（Tempo/Loki/Prometheus）。
# 留空则应用自动降级为「无监控」模式，不影响任何业务。多实例均指向同一个 Collector 即可水平扩展。
# 端点为 Collector 的 OTLP HTTP 地址（默认 4318）。示例（与 docker-compose.observability.yml 同网络时）：
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# 若 Collector 启用了鉴权，可附带头（逗号分隔的 key=value 列表）：
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer XXX
# 服务名（出现在 Trace/Metrics/Logs 的 service.name 维度）：
# OTEL_SERVICE_NAME=circleica

# ── Turnstile 验证码（可选，用于注册防机器人）──
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── UploadThing 文件上传（可选）──
# UPLOADTHING_TOKEN=

# ═══════════════════════════════════════════
# 构建时变量（仅 Sentry sourcemap 上传需要，运行时无需设置）
# ═══════════════════════════════════════════
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# ── Galvelica 多源融合（可选）──
# CnGal 资料站 API 令牌（可选，用于提额/鉴权；缺失则匿名访问）
# CNGL_API_TOKEN=
# Bangumi 个人访问令牌（可选，配置后接入 Bangumi 多源融合）
# BANGUMI_ACCESS_TOKEN=
# 严格同人闸门（可选，默认 1=只收带同人标签的源；设 0 放开以收录月幕 YmGal 等广义 galge 源）
# GALVELICA_DOUJIN_ONLY=1
# 省空间模式（可选，默认 0=融合后清理原始 JSON 缓存；设 1 保留 raw 以便离线重融合）
# GALVELICA_KEEP_RAW=0
