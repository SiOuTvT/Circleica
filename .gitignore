# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# user uploads
/public/uploads

# audit tool local cache (regenerable, not part of the project)
.auditcache/

# Galvelica 广收录断点续跑状态文件（运行时生成，非项目内容）
.galvelica-ingest.json
.galvelica-ingest-ymgal.json
.galvelica-ingest-cngal.json
.galvelica-ingest-discovery.json

# agent 工作记忆（本地记忆/日志，非项目内容，禁止提交）
.workbuddy/

# agent 临时产物（截图/日志/一次性脚本，禁止提交进仓库；物理文件一律放系统 TEMP，不放项目内）
.dev_webpack*.log
kill_dev*.cmd
.next_turbobak
.probe*/
.tmpshots/
.shot*
.fix_nul.cjs
.shoot*.cjs
check.cjs
dump*.cjs
verify*.cjs
