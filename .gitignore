# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# user uploads
/public/uploads

# audit tool local cache (regenerable, not part of the project)
.auditcache/

# Galvelica 广收录断点续跑状态文件（运行时生成，非项目内容）
.galvelica-ingest.json
.galvelica-ingest-ymgal.json
.galvelica-ingest-cngal.json
.galvelica-ingest-discovery.json

# agent 工作记忆（本地记忆/日志，非项目内容，禁止提交）
.workbuddy/

# agent 临时产物（截图/日志/一次性脚本，禁止提交进仓库；物理文件一律放系统 TEMP，不放项目内）
.dev_webpack*.log
kill_dev*.cmd
# 调试/验证时改名的 .next 残留（.next_bak / .next_bak_perf / .next_bak_pre_final / .next_verify_bak 等），禁止提交；应移出项目或清理
.next_turbobak
.next_bak
.next_bak/
.next_bak*
.next_verify_bak
.next_verify_bak/
.next_*bak*
.next_*bak*/
# 构建绕行产生的改名 .next（横杠时间戳版 .next-bak-<ts> / .next-partial-<ts>），禁止提交；应移出项目或清理
.next-bak*
.next-bak*/
.next-partial*
.next-partial*/
# Windows 保留名误生成文件（重定向 > nul 偶发），禁止提交
/nul
.next-verify
.next-verify/
.next-verify.bak
.next-verify.bak/
.next-pv
.next-pv/
.next-pv*
.next-pv.bak
.next-pv.bak/
.probe*/
.tmpshots/
.shot*
.fix_nul.cjs
.shoot*.cjs
check.cjs
dump*.cjs
verify*.cjs

# ============================================================
# 仓库展示文档（例外：刻意纳入版本控制）
# README.md / LICENSE 是仓库对外展示文档，保留提交。
# ============================================================

# ============================================================
# 其他文档 / 过程产物（排除：不纳入提交）
# 除 README.md / LICENSE 外的所有 .md（AGENTS / CLAUDE / DEPLOYMENT /
# HANDOVER / 各类评审报告）、docs/、deliverables/（agent 报告）、
# screenshots/、responsive-audit/（测试截图）、preview-layouts/（预览 HTML）
# 等内部 / 临时文档与产物一律排除。
# ============================================================
*.md
!README.md
!LICENSE.md
docs/
deliverables/
screenshots/
responsive-audit/
preview-layouts/

# ---------- 额外通用排除（补充）----------
# 缓存 / 构建中间产物
.cache/
.eslintcache
.turbo/
*.tsbuildinfo

# 测试 / e2e 产物
/test-results
/playwright-report
/coverage

# 临时 / 系统文件
tmp/
temp/
*.tmp
.idea/
.vscode/
Thumbs.db

# 数据库 / 本地数据文件（非项目代码）
*.db
*.sqlite
*.sqlite3
/pgdata
